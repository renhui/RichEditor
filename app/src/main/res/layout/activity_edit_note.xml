<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/title"
        android:orientation="vertical"
        android:padding="14dp">

        <EditText
            android:id="@+id/editor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:hint="@string/note_editor_title"
            android:padding="14dp"
            android:textColor="@color/ui_text_primary"
            android:textColorHint="@color/ui_text_secondary"
            android:textSize="17sp" />

        <com.example.richtext.ui.widget.RichEditor
            android:id="@+id/richEditor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_toolbar_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <ImageView
            android:id="@+id/button1"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_toolbar_action"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_gallery" />

        <ImageView
            android:id="@+id/button2"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_toolbar_action"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_camera" />

        <ImageView
            android:id="@+id/button3"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_toolbar_action"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_edit" />

        <ImageView
            android:id="@+id/share"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_toolbar_action"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_share" />
    </LinearLayout>

</RelativeLayout>