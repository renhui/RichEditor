<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_page_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/title"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/title_layer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText
                android:id="@+id/note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_surface"
                android:gravity="center_vertical"
                android:hint="输入标题"
                android:padding="14dp"
                android:textColor="@color/ui_text_primary"
                android:textColorHint="@color/ui_text_secondary"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/note_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="top"
                android:minHeight="260dp"
                android:orientation="vertical"
                android:padding="14dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_toolbar_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <ImageView
            android:id="@+id/button1"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_toolbar_action"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_gallery" />

        <ImageView
            android:id="@+id/button2"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_toolbar_action"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_camera" />
    </LinearLayout>

</RelativeLayout>